rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /attendanceRecords/{document=**} {
      // allow unauthenticated create for the ESP32 to push attendance? 
      // Actually ESP32 will need an API or some way to write. Let's allow write.
      allow write: if true;
    }
  }
}
